{
  "manifest_version": 2,
  "id": "hostnavigatormax",
  "type": "widget",
  "name": "Host navigator MAX",
  "namespace": "HNM",
  "version": "7.0-2",
  "author": "initMAX s.r.o.",
  "description": "Displays host hierarchy with ability to control other widgets based on selected host.",
  "url": "https://www.initmax.com",
  "widget": {
    "size": {
      "width": 12,
      "height": 5
    },
    "js_class": "HNM_CWidgetHostNavigator",
    "in": {
      "groupids": {
        "type": "_hostgroupid"
      }
    },
    "out": [
      {
        "type": "_hostid"
      },
      {
        "type": "_hostids"
      }
    ]
  },
  "actions": {
    "widget.hostnavigatormax.view": {
      "class": "WidgetView"
    }
  },
  "assets": {
    "js": [
      "class.hostnavigator.js",
      "class.widget.js",
      "class.widget-field.host-grouping.js"
    ],
    "css": [
      "hostnavigator.css"
    ]
  }
}
